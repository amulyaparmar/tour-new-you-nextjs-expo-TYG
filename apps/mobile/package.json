{
  "name": "@tour/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client",
    "dev:go": "expo start --go",
    "dev:client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "update:production": "npx eas-cli@latest update --channel production --non-interactive",
    "update:preview": "npx eas-cli@latest update --channel preview --non-interactive",
    "testflight": "npx testflight",
    "lint": "echo \"No mobile lint configured\"",
    "typecheck": "node scripts/check-style-health.js && tsc --noEmit",
    "clean": "rm -rf .expo dist"
  },
