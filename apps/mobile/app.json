{
  "expo": {
    "name": "Tour",
    "owner": "tourtyg",
    "slug": "tour-new-tour-you-tyg",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "tournewtouryoutyg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/tour-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "reactCompiler": true
    },
    "runtimeVersion": "0.1.0",
    "updates": {
      "url": "https://u.expo.dev/a30cd0f8-93f0-423b-979b-2c415aa6a5c4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leasemagnets.tournewtouryou.tyg",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Tour needs local network access to reach your development server on this Mac.",
        "NSBonjourServices": ["_http._tcp", "_expo._tcp"],
        "NSMicrophoneUsageDescription": "Allow Tour to record leasing conversations for session analysis and coaching.",
        "NSSpeechRecognitionUsageDescription": "Allow Tour to transcribe leasing conversations during tours.",
        "UIBackgroundModes": ["audio", "voip", "remote-notification"]
      }
    },
    "android": {
      "package": "com.leasemagnets.tournewtouryou.tyg",
      "permissions": ["android.permission.RECORD_AUDIO"],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4D8AE5"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4D8AE5"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Tour to record leasing conversations for session analysis and coaching.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-speech-transcriber",
        {
          "speechRecognitionPermission": "Allow Tour to transcribe leasing conversations during tours.",
          "microphonePermission": "Allow Tour to listen during a tour for live transcription."
        }
      ],
      "expo-live-activity",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a30cd0f8-93f0-423b-979b-2c415aa6a5c4"
      }
    }
  }
}
