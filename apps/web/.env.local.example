SUPABASE_PROJECT_ID=tkweddqlriikqgylsuxz
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://tkweddqlriikqgylsuxz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
TOUR_APP_REVIEW_EMAIL=apple@testemail.com
TOUR_APP_REVIEW_OTP=123456
GOOGLE_PLACES_API_KEY=
TOUR_API_BASE_URL=https://tour.new
# ElevenLabs is the default. Authenticated @leasemagnets.com users can select
# another configured provider per rubric.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2
GEMINI_API_KEY=
# GEMINI_AUDIO_MODEL=gemini-3.6-flash
# Comma-separated audio-capable fallbacks. Defaults to all remaining supported audio models.
# Set to none to disable fallback.
# GEMINI_AUDIO_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-pro
# Native SDK attempts per model before advancing through the fallback chain.
# GEMINI_MODEL_MAX_ATTEMPTS=2
# Gemini starts on Standard and escalates to Priority only for retryable provider failures.
# GEMINI_SERVICE_TIER=standard
# Set to none to disable tier fallback, or standard/flex/priority to customize it.
# GEMINI_FALLBACK_SERVICE_TIER=priority
# GEMINI_AUDIO_INSIGHTS_TIMEOUT_MS=600000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional server-only pairwise AI seam repair for six-shot panoramas.
# Without this key, panorama creation uses the deterministic smart stitcher.
FAL_KEY=
# FAL_PANORAMA_INPAINT_MODEL=fal-ai/z-image/turbo/inpaint
DEEPGRAM_API_KEY=
NEXT_PUBLIC_SITE_URL=https://tour.you
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
# BEDROCK_OPENAI_MODEL=openai.gpt-5.4

# SMS delivery and optional server-to-server access for contextual follow-ups.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=+14157352992
TWILIO_VOICE_API_KEY=
TWILIO_VOICE_API_SECRET=
# Twilio Console > Voice > Manage > TwiML apps. Point its Voice URL to:
# https://tour.you/api/phone-calls/twiml
TWILIO_VOICE_TWIML_APP_SID=
TWILIO_VALIDATE_SIGNATURE=true
CONTEXTUAL_FOLLOW_UP_API_SECRET=

# Property access-request email. The sender must be verified in Cloudflare Email Sending.
# Recommended: protected Cloudflare Email Worker (no Cloudflare API token in Vercel).
TOUR_EMAIL_WORKER_URL=
TOUR_EMAIL_WORKER_TOKEN=
# Optional direct REST fallback:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=notifications@tour.report

# Comma-separated domains allowed to open and switch into any property session.
TOUR_GLOBAL_PROPERTY_ADMIN_DOMAINS=leasemagnets.com

# Optional dedicated HMAC secret for server-side sign-in-code verification.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when omitted.
TOUR_OTP_SIGNING_SECRET=

# AI Roleplay Training (Vapi voice roleplay). Public key + assistant id are
# client-exposed by design; the private key is server-only (post-call analysis,
# recording playback proxy, waypoint-generation fallback).
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
VAPI_PRIVATE_KEY=
