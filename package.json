{
  "name": "tour-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:web": "turbo build --filter=@tour/web",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "typecheck:web": "turbo typecheck --filter=@tour/web",
    "web": "turbo dev --filter=@tour/web",
    "workflow:web": "npm --workspace @tour/web run workflow:web",
    "workflow:runs": "npm --workspace @tour/web run workflow:runs",
    "admin": "turbo dev --filter=@tour/admin",
    "build:admin": "turbo build --filter=@tour/admin",
    "typecheck:admin": "turbo typecheck --filter=@tour/admin",
    "mobile": "turbo dev --filter=@tour/mobile",
    "mobile:dev-client": "npm --workspace @tour/mobile run dev:client",
    "mobile:build:ios": "npm --workspace @tour/mobile run build:ios",
    "mobile:submit:ios": "npm --workspace @tour/mobile run submit:ios",
    "mobile:testflight": "npm --workspace @tour/mobile run testflight",
    "mobile:update:preview": "npm --workspace @tour/mobile run update:preview",
    "mobile:update:production": "npm --workspace @tour/mobile run update:production",
    "postinstall": "node scripts/apply-patches.cjs"
  },
  "devDependencies": {
    "expo": "^57.0.17",
    "next": "^16.0.0",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-image": "0.15.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.1.1",
    "turbo": "^2.8.0",
    "typescript": "^6.0.3"
  }
}
